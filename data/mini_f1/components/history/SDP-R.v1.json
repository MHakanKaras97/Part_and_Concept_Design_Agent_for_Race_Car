  "spec": {
    "id": "SDP-R",
    "name": "Sidepod right",
    "role": "right sidepod bodywork with radiator inlet, beside the monocoque",
    "notes": "Red lofted solid, local X 0 (front) to -2250 (rear), bottom flat at local Z 0 on the floor top. Inner wall Y: 280 at X0, 372 at -700, 426 at -1900, 431 at -2250 (embeds <=25 into monocoque). Outer wall Y: ~620 at X0, 700 at -500, 540 at -2250. Top Z: 370 at X0, 390 at -1100, 270 at -2250, top edges filleted ~60. Front-face inlet pocket ~200(Y) x 150(Z), 120 deep, centred Y~460, Z~220. Modest outer lower undercut (~60 mm) only if robust.",
    "dims": {
      "length": 2250.0,
      "front_inner_half_width": 280.0,
      "max_outer_half_width": 700.0,
      "rear_outer_half_width": 540.0,
